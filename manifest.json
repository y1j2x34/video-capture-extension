{
  "manifest_version": 3,
  "name": "VideoCaptureX",
  "version": "1.0.0",
  "description": "Record HTML5 video elements with captureStream and download the result.",
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
